{
  "name": "torrentstream-server",
  "version": "1.0.0",
  "description": "Torrent streaming server with WebTorrent integration",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./tailwind.css --minify",
    "dev:css": "tailwindcss -i ./src/styles/tailwind.css -o ./tailwind.css --watch",
    "install-deps": "npm install"
  },
  "dependencies": {
    "axios": "1.13.2",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "https-proxy-agent": "^7.0.6",
    "ms": "^2.1.3",
    "pg": "^8.12.0",
    "webtorrent": "^1.9.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.22",
    "nodemon": "^3.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.10"
  },
  "keywords": [
    "torrent",
    "streaming",
    "webtorrent",
    "p2p",
    "audio"
  ],
  "author": "TorrentStream",
  "license": "MIT"
}
